# Copy to real env store; do not commit secrets.

# App
NODE_ENV=production
APP_NAME=wandreel
APP_URL=https://wandreel.com
PUBLIC_APP_URL=https://wandreel.com

# API
API_BASE_URL=https://api.wandreel.com
PORT=8787
CORS_ALLOWED_ORIGINS=https://wandreel.com
COOKIE_DOMAIN=.wandreel.com
CLIENT_ORIGIN=https://wandreel.com

# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5-nano

# Auth
DATABASE_URL=replace_me
VITE_GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_ID=replace_me
EMAIL_OTP_DEV_MODE=false

# Maps and place resolution
GOOGLE_MAPS_API_KEY=replace_me

# Intelligence endpoint defaults
INTELLIGENCE_DEFAULT_MODE=sync
INTELLIGENCE_ASYNC_ADAPTER=memory

# Optional logging
LOG_LEVEL=info
