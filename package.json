{
  "name": "wandreel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test:intelligence": "tsx --test server/extraction/tests/visualFallback.test.ts server/intelligence/tests/async.test.ts server/intelligence/tests/buildUserPrompt.test.ts server/intelligence/tests/normalize.test.ts server/intelligence/tests/prompts.test.ts server/intelligence/tests/schema.test.ts",
    "extract:runtime:check": "python server/extraction/scripts/check_runtime_health.py",
    "deploy:preflight": "node deployment/scripts/preflight.mjs",
    "deploy:preflight:win": "powershell -ExecutionPolicy Bypass -File deployment/scripts/run-preflight.ps1",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "openai": "^6.39.0",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "js-tokens": "^9.0.0",
    "playwright": "^1.60.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.95.0"
  }
}
